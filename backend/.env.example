# Copy this file to .env and replace YOUR_POSTGRES_PASSWORD.
# URL-encode the password if it contains reserved URL characters.
QUIZSTAKE_DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/quizstake
QUIZSTAKE_CORS_ORIGINS=http://localhost:4200
QUIZSTAKE_GLOBAL_MAX_QUESTIONS=100
